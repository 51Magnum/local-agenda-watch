{
  "state": "id",
  "timezone": "America/Boise",
  "enabled": true,
  "launchStatus": "admin_only",
  "selfCheck": {
    "minPassRate": 0.95,
    "mustInclude": [
      "202600273",
      "202601088",
      "202600638",
      "202601398",
      "202601317",
      "202600819",
      "202600934",
      "202103209"
    ]
  },
  "sourcesVerifiedAt": "2026-10-27",
  "documents": {
    "maxBytes": 45000000,
    "maxPages": 80,
    "allowPackets": false,
    "maxNativeBytes": 160000000,
    "countyAuthoredKinds": [
      "report",
      "agenda",
      "staff_report",
      "findings",
      "memo",
      "tabling_memo",
      "minutes",
      "notice"
    ],
    "officialPaths": [
      {
        "host": "apps.adacounty.id.gov",
        "pathname": "/AdaFileBrowse/Home/OpenDocument",
        "query": {
          "papp": "DS_Agendas"
        }
      }
    ]
  },
  "id": "ada-county",
  "name": "Ada County",
  "type": "county",
  "color": "#3f6212",
  "mapOrder": 2,
  "boundary": {
    "source": "arcgis",
    "url": "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/Geopolitical/Geopolitical/MapServer/9",
    "where": "county_name='Ada'",
    "outSR": 4326,
    "expectedFeatureCount": 1,
    "expectedProperties": {
      "county_name": "Ada"
    }
  },
  "clipRule": {
    "operation": "subtractCityLimits",
    "layer": {
      "source": "arcgis",
      "url": "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/Geopolitical/Geopolitical/MapServer/3",
      "where": "1=1",
      "outSR": 4326
    }
  },
  "agenda": [
    {
      "adapter": "adaFileBrowse",
      "params": {
        "baseUrl": "https://apps.adacounty.id.gov/AdaFileBrowse/",
        "papp": "DS_Agendas",
        "hearingsUrl": "https://adacounty.id.gov/developmentservices/community-planning-division/public-hearings-agendas/",
        "scheduleYear": 2026,
        "scheduleTables": [
          {
            "index": 0,
            "body": "bocc"
          },
          {
            "index": 1,
            "body": "pzc"
          }
        ]
      },
      "bodies": [
        "pzc",
        "bocc"
      ]
    }
  ],
  "applications": {
    "adapter": "arcgisFeatureLayer",
    "params": {
      "url": "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/DevelopmentServices/Planning_and_Building/MapServer/14",
      "where": "AppDivision='PZ'",
      "fields": {
        "id": "APPFILE",
        "name": "AppApplicDesc",
        "type": "APTDescription",
        "status": "STATUS",
        "parcel": "PARCEL",
        "description": "AppApplicDesc",
        "received": "APPRcvdDate"
      },
      "flumField": "Name",
      "projectKey": {
        "fields": [
          "APPFileNum",
          "PRJProjectNum"
        ],
        "pattern": "^\\d{9}"
      },
      "hearingSuffixes": [
        "ZC",
        "DA",
        "S",
        "PUD",
        "CU",
        "V",
        "VAC",
        "A",
        "CPA",
        "TE"
      ],
      "applicantField": "APPLICANT"
    },
    "recordUrlTemplate": "https://gisprod.adacounty.id.gov/apps/application_tracker/?find={recordId}"
  },
  "gis": {
    "countyBoundary": "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/Geopolitical/Geopolitical/MapServer/9",
    "cityLimits": "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/Geopolitical/Geopolitical/MapServer/3",
    "impactAreas": "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/LandUse/LandUse/MapServer/20",
    "futureLandUse": "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/LandUse/LandUse/MapServer/1",
    "zoning": "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/LandUse/LandUse/MapServer/13",
    "parcels": "https://services2.arcgis.com/dgGjZc6xAH5m5JyP/arcgis/rest/services/Parcels/FeatureServer/5"
  },
  "hearingBodies": [
    {
      "key": "pzc",
      "name": "Planning and Zoning Commission",
      "role": "recommending",
      "agendaBodyMatch": "PZC"
    },
    {
      "key": "bocc",
      "name": "Board of County Commissioners",
      "role": "deciding",
      "agendaBodyMatch": "BOCC"
    }
  ],
  "caseNumberPatterns": [
    "\\b\\d{9}(?:-[A-Z]{1,5})+\\b"
  ],
  "participation": {
    "testimonySignupUrl": "https://adacounty.id.gov/developmentservices/public-hearing-testimony-sign-up/",
    "deadlineRules": [
      {
        "kind": "written",
        "rule": "THU_BEFORE COB",
        "timeVerified": false,
        "sourceUrl": "https://adacounty.id.gov/developmentservices/community-planning-division/public-hearings-agendas/"
      },
      {
        "kind": "remote",
        "rule": "MON_BEFORE DATE_ONLY",
        "timeVerified": false,
        "sourceUrl": "https://adacounty.id.gov/developmentservices/public-hearing-testimony-sign-up/"
      }
    ],
    "hearingsUrl": "https://adacounty.id.gov/developmentservices/community-planning-division/public-hearings-agendas/",
    "legalNoticesUrl": "https://adacounty.id.gov/legal-notices/"
  },
  "costCaps": {
    "backfillUsd": 5,
    "monthlyUsd": 5,
    "perDocMaxTokens": 60000
  },
  "notes": [
    "Listings, GIS, participation endpoints and per-item documents checked from local ingestion and a Git-sourced Vercel preview on 2026-10-27. Production runtime is not verified.",
    "Filter AppDivision=PZ; do not backfill all historic building/zoning-certificate records.",
    "Close of business has no verified clock time; retain a date and qualified label, never invent 17:00.",
    "Use DS_Agendas only, never the general BOCCAgendas archive.",
    "Tentative hearing schedule is context; an actual agenda confirms a hearing.",
    "Application metadata has no address field. Do not manufacture an address from a parcel number.",
    "County boundary selection is county_name='Ada'; layer 9 also contains six neighboring counties and must never be collected with where=1=1. Verified 2026-10-28."
  ],
  "area": {
    "country": "us",
    "countryName": "United States",
