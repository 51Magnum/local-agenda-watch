      "https://gisprodapi.adacounty.id.gov/arcgis/rest/services/Geopolitical/Geopolitical/MapServer/9/query?where=county_name%3D%27Ada%27&outFields=*&outSR=4326&f=pjson"
    ],
    "bodies": {
      "planning": {
        "id": "P&Z",
