      "hosts": [
        "apps.adacounty.id.gov",
        "adacounty.id.gov",
        "gisprod.adacounty.id.gov",
        "gisprodapi.adacounty.id.gov"
      ],
      "documentRules": [
        {
          "kind": "staff-report",
