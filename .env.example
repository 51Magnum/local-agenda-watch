# Neon: choose the pooled PostgreSQL connection string, with sslmode=require.
DATABASE_URL=
# Server-only OpenAI key. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
# Use independent random secrets. Admin username is admin.
REVIEW_ADMIN_PASSWORD=
CRON_SECRET=
# All live jurisdictions: active, upcoming, and unresolved cases. Optional comma-separated allowlist.
TIMELINE_CASE_IDS=*
# Optional JSON array of verified official document URLs when a download is portal-mediated.
# [{"url":"https://www.cityofnampa.us/DocumentCenter/View/...","title":"PZ Decision Letter","caseIds":["ANN-00371-2026","SPP-00184-2026"]}]
TIMELINE_SOURCE_REGISTRY=

# Shared UTC-day budget, reservations included; $3 by default.
OPENAI_DAILY_BUDGET_USD=3
RESEND_API_KEY=
ALERTS_FROM=Local Agenda Watch <alerts@localagendawatch.com>
ALERTS_REPLY_TO=hello@localagendawatch.com
ALERTS_MAILING_ADDRESS=
# Keep false until the owner explicitly approves a waitlist confirmation send.
ALERTS_WAITLIST_CONFIRMATIONS_ENABLED=false
